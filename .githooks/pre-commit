#!/bin/sh
# Same guards CI runs, so a commit cannot pass here and fail there.
# Install with: just install-hooks
#
# doc-image.py is not run here: it needs a populated build/ rootfs, which most
# checkouts do not have, so it would print a skip banner on every commit. It is
# a local gate, `just image`, run by hand after a build.
#
# Both checks run even when the first fails, matching `just verify`: two
# independent findings are worth more than the first one twice.
rc=0

# Setting this repo's own core.hooksPath OVERRIDES the machine-global
# core.hooksPath, which would otherwise run the global gitleaks pre-commit -- and
# that one fails CLOSED (no scanner, no commit) where ci-guards.sh's gitleaks is
# optional. Chain to it explicitly so our hooks do not silently drop that
# guarantee. If it is armed and missing, that is itself a failure, not a skip.
global_dir=$(git config --global core.hooksPath 2>/dev/null)
# \~ , not "~": a case pattern is tilde-expanded, so the tilde is escaped to
# match the literal character git stored.
case "$global_dir" in
    \~/*) global_dir="$HOME/${global_dir#\~/}" ;;
    \~)   global_dir="$HOME" ;;
esac
if [ -n "$global_dir" ]; then
    if [ -x "$global_dir/pre-commit" ]; then
        "$global_dir/pre-commit" || rc=1
    else
        echo "pre-commit: global hook armed at $global_dir but no runnable pre-commit there" >&2
        rc=1
    fi
fi

tools/ci-guards.sh || rc=1
python3 tools/doc-links.py || rc=1
# Named here as well as inside ci-guards.sh guard 11, and the duplicate scan is
# the point: this call is the STRICT one. ci-guards runs the scanner with
# --allow-partial because it also runs in CI, where the identity map cannot
# exist; here the map does exist, so a run that cannot see it is a failure
# rather than a pass. ci-guards guard 11 asserts this call is still here, so
# deleting it fails the guards rather than going quiet.
tools/scrub-identity.py --check || rc=1
exit $rc
