#!/bin/sh
# Run by xinit, so DISPLAY is already set.
#
# Replaces the `while true; do surf; sleep 10; done` loop from the Raspbian
# kiosk -- systemd Restart=always does that job now.
export SURF_OVERRIDE_REDIRECT=1
export SURF_MILESTONES=1

# The rendering architecture, measured rather than chosen. Accelerated
# compositing runs 5.2x worse than software on this SoC, and the forced vblank
# timer is part of every board configuration those numbers were taken on -- see
# docs/issue_investigation/gpu_compositing/README.md under "Engine levers,
# measured and exhausted" and "Changes configured as a result". They belong in
# the image rather than in /data/config/kiosk.conf, which reproduces on no
# reflash: tools/provision.sh writes that file wholesale from the site template,
# so a renderer setting kept there is destroyed by the next provisioning run.
#
# Defaults, not hard sets. Both variables are value-sensitive in WebKit and read
# "0" as off, so kiosk.service's EnvironmentFile can still re-test either arm
# over the wire without a build; an unconditional export here would silently
# beat the device's own config file.
: "${WEBKIT_DISABLE_DMABUF_RENDERER:=1}"
: "${WEBKIT_FORCE_VBLANK_TIMER:=1}"
export WEBKIT_DISABLE_DMABUF_RENDERER WEBKIT_FORCE_VBLANK_TIMER

# Remote Web Inspector. OFF by default for two reasons: it must not perturb a
# complete-display measurement, and it should not listen unless asked. Turn it
# on over SSH with no rebuild and no trip to the device:
#
#   echo 'KIOSK_INSPECTOR=1' >> /data/config/kiosk.conf   # kiosk.service EnvironmentFile
#   systemctl restart kiosk
#   # then from the workstation:  ssh -L 2999:127.0.0.1:2999 root@<kiosk>
#
# Bound to loopback, reached through a tunnel -- the same shape the Chromium
# arm used with --remote-debugging-port=9222. This is the replacement for CDP:
# different protocol, same capability.
INSPECT=""
if [ "${KIOSK_INSPECTOR:-0}" = "1" ]; then
	export WEBKIT_INSPECTOR_SERVER="${KIOSK_INSPECTOR_BIND:-127.0.0.1:2999}"
	INSPECT="-N"
fi

# 1280x720 on a panel the firmware brings up at 1080p. Pixel area is what the
# during-motion framerate is bound by -- a 2.25x cut doubles it, and it is the
# one display-stack lever that moves the number at all. See
# docs/issue_investigation/gpu_compositing/README.md under "Engine levers,
# measured and exhausted".
#
# Not fatal and not silenced. A refused mode-set leaves the firmware's 1080p,
# which renders correctly and slower, so it must not stop the browser starting;
# xrandr's own diagnostic and the line below both reach the journal, which is
# what distinguishes that from a mode-set that took.
xrandr --output HDMI-1 --mode 1280x720 ||
	echo "kiosk-launch: 1280x720 mode-set failed, panel stays at the firmware mode" >&2

# There is no backend-readiness wait before the exec, and one must not be built
# on busybox `nc`: it exits 1 against an open port as well as a closed one, so
# the probe can never report success -- a readiness check that cannot pass looks
# exactly like a backend that is never ready. kiosk.service already gates on
# network-online.target, which is the part that was doing any work.
#
# Milestones go to BOTH the journal and a file: measure-surf.sh reads the file,
# and the journal is what makes a first boot debuggable over SSH.
exec surf -K $INSPECT "$KIOSK_URL" 2>&1 | tee /var/log/surf-milestones.log
