[Unit]
Description=Withhold RAUC good-marking until the LAN is reachable
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kiosk-netcheck
TimeoutStartSec=180

[Install]
RequiredBy=boot-complete.target
