[Unit]
Description=Boot CPU and disk-I/O sampler (diagnostic; not part of the kiosk)
DefaultDependencies=no
Before=local-fs-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/kiosk-bootprof 150 500 /data/boot-cpu-io mmcblk0
IOSchedulingClass=idle

[Install]
WantedBy=sysinit.target
