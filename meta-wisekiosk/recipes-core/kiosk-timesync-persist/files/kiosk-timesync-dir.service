[Unit]
Description=Stage the persistent timesync clock dir on /data
# The BindPaths source in the systemd-timesyncd drop-in must exist each time that
# unit's namespace is built, or namespace setup fails 226/NAMESPACE and -- with
# timesyncd's Restart=always/RestartSec=0 -- burns the start limit in ms and the
# board never syncs time. timesyncd restarts on its own (WatchdogSec=3min), and
# its view of /data can change under it: on a degraded boot data.mount fails, this
# runs before the mount, so the dir lands on the rootfs; then mount-fdir mounts
# the real /data over it and a later restart would bind an empty /data. So this is
# NOT RemainAfterExit -- the drop-in Wants=+After= it, so it re-runs on every
# timesyncd start and re-stages against whatever /data currently is.
#
# After=data.mount holds the mkdir until the mount reaches a terminal state, so on
# the normal boot the dir is created on the real /data. No Requires=: a failed
# /data must not cancel NTP (mirrors every other /data consumer). The degraded
# cost is explicit: the clock is written to the rootfs slot and is silently
# non-persistent for that boot until the next stage puts it back on /data.
DefaultDependencies=no
After=data.mount
Before=systemd-timesyncd.service
# The oneshot re-runs on every timesyncd start (incl. watchdog restarts); its own
# default 5-starts/10s limit would otherwise trip on an unrelated timesyncd crash-
# loop and silently stop staging for the boot. It has no self-restart to bound.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# One statement, so the exit status is single-valued: a mkdir failure short-
# circuits chown, so the unit cannot exit 0 with the dir created but left
# root-owned (which timesyncd's User= could not write -- an EACCES swallowed at
# log_debug). It does not make the filesystem effect atomic; it makes a
# success-with-unowned-dir unreportable. chown -R also re-owns the pre-existing
# clock file, defusing a dynamic-UID shift across an OTA.
ExecStart=/bin/sh -c 'mkdir -p /data/systemd-timesync && exec chown -R systemd-timesync:systemd-timesync /data/systemd-timesync'

[Install]
WantedBy=sysinit.target
