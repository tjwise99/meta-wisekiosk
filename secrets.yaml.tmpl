##########
# HEADER #
##########
# Copy to secrets.yaml and fill in. secrets.yaml is gitignored; this template is
# tracked and MUST keep every value empty.
#
# This repository is public. The values below are not credential-shaped -- an
# SSID, a LAN address or a hostname passes every secret scanner while still
# fingerprinting the site -- so they live here rather than in any tracked config.
header:
  version: 20

# WARNING: kas merges local_conf_header as a dict keyed by BLOCK NAME, and the
# top-level kas file wins. A block named the same as one in kiosk-zero-w.yaml
# is silently discarded -- no warning, no error, just variables that never
# reach bitbake. Keep every key here unique against that file.
local_conf_header:
  wifi: |
    WIFI_SSID = ""
    WIFI_PSK_HASH = ""

  device: |
    KIOSK_URL = ""
    KIOSK_HOSTNAME = ""
    MIRROR_HOST = ""

  # Uncomment and fill in ONLY if you actually run a cache server. Left active
  # with the placeholder host, bitbake resolves <cache_server>.tld on every
  # source fetch and on hash-equivalence startup -- a failed DNS lookup per
  # fetch, and a warning that reads like a misconfiguration.
  sourcecontrol: |
    # SOURCE_MIRROR_URL ?= "http://<cache_server>.tld/sources/"
    # BB_HASHSERVE_UPSTREAM = "<cache_server>.tld:8686"
    # SSTATE_MIRRORS ?= "file://.* http://<cache_server>.tld/sstate/PATH;downloadfilename=PATH"
