+void
+milestone(const char *name)
+{
+	if (!milestones)
+		return;
+	fprintf(stderr, "SURFMS %s %.3f\n", name,
+	        (g_get_monotonic_time() - surfstart_us) / 1000000.0);
+	fflush(stderr);
+}
