 void
+placeoverrideredirect(Client *c)
+{
+	GdkRectangle geo = { 0, 0, 0, 0 };
+	GdkDisplay *d;
+	GdkMonitor *mon;
+	const char *env;
+	int w = 0, h = 0;
+
+	if ((env = getenv("SURF_GEOMETRY")) && sscanf(env, "%dx%d", &w, &h) == 2
+	    && w > 0 && h > 0) {
+		geo.width = w;
+		geo.height = h;
+	} else if ((d = gdk_display_get_default())
+	           && (mon = gdk_display_get_monitor(d, 0))) {
+		gdk_monitor_get_geometry(mon, &geo);
+	}
+
+	/* Fail back to the window manager rather than guess. A zero-sized
+	 * override-redirect window is an invisible kiosk, indistinguishable
+	 * from a crashed one. */
+	if (geo.width <= 0 || geo.height <= 0) {
+		fprintf(stderr, "surf: no usable monitor geometry, "
+		        "leaving the window manager in charge\n");
+		overrideredirect = 0;
+		return;
+	}
+
+	gtk_window_set_decorated(GTK_WINDOW(c->win), FALSE);
+	gtk_window_set_default_size(GTK_WINDOW(c->win), geo.width, geo.height);
+	gtk_widget_realize(c->win);
+	gdk_window_set_override_redirect(gtk_widget_get_window(c->win), TRUE);
+	gtk_window_move(GTK_WINDOW(c->win), geo.x, geo.y);
+	gtk_window_resize(GTK_WINDOW(c->win), geo.width, geo.height);
+	milestone("override_redirect_placed");
+}
