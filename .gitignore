.venv/
build/
sources/
.kas_shell_history
secrets.yaml

# Operator notes about the physical units -- serials, MACs, addresses, one-off
# readings -- and local/keys, where the fleet RAUC signing key lives. The notes
# are individually harmless and together a fingerprint of one network; the key is
# the one every fielded device trusts. Both sit in the working tree, because the
# build has to read the key from the tree kas-container mounts, so NOT COMMITTING
# them is the whole protection. See docs/rauc-key-rotation.md.
local/

# The skills under .claude/ are tracked; these two are per-checkout machine
# state, and settings.local.json in particular carries local filesystem paths.
.claude/settings.local.json
.claude/scheduled_tasks.lock
